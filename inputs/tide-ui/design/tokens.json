{
  "meta": {
    "project": "潮汐记事",
    "spec": "UI-SPEC.md v1",
    "engine": "Godot 4.7.2",
    "canvas": [1280, 720],
    "stretch": "canvas_items",
    "grid": 4,
    "safeArea": { "top": 24, "right": 24, "bottom": 24, "left": 24 },
    "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64]
  },

  "color": {
    "ink": {
      "950": "#070C10",
      "900": "#0C1319",
      "850": "#101A21",
      "800": "#16222B",
      "700": "#22323D"
    },
    "fog": {
      "50": "#F5F3EA",
      "100": "#E8E5D8",
      "300": "#A9B3AF",
      "500": "#6E7A78"
    },
    "copper": {
      "300": "#F0C46A",
      "400": "#E8B04B",
      "500": "#C08A33",
      "700": "#7A5A22",
      "a72": "rgba(232,176,75,0.72)",
      "a42": "rgba(232,176,75,0.42)",
      "a22": "rgba(232,176,75,0.22)"
    },
    "sea": {
      "300": "#9FD3E6",
      "700": "#2C5A6B"
    },
    "paper": {
      "100": "#F7F0E2",
      "200": "#EFE5D2",
      "ink": "#1A2939",
      "muted": "#5E5342",
      "rule": "#CDBF9F",
      "ruleStrong": "#B8A57E"
    },
    "semantic": {
      "panelBg": "rgba(12,19,25,0.92)",
      "panelBgNight": "rgba(12,19,25,0.96)",
      "modalMask": "rgba(7,12,16,0.72)",
      "letterMask": "rgba(7,12,16,0.55)",
      "hoverFill": "rgba(232,176,75,0.06)",
      "focusFill": "rgba(232,176,75,0.10)",
      "rowRule": "rgba(232,176,75,0.10)",
      "textOnInk": "#F5F3EA",
      "textMuted": "#A9B3AF",
      "textDisabled": "#6E7A78",
      "accent": "#E8B04B",
      "interactive": "#9FD3E6"
    }
  },

  "font": {
    "narrative": ["Noto Serif SC", "Source Han Serif SC", "Songti SC", "serif"],
    "ui": ["Noto Sans SC", "Source Han Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"]
  },

  "type": {
    "micro":   { "size": 12, "lineHeight": 16, "letterSpacing": 0.5, "use": "键帽字、角标、已送标记" },
    "meta":    { "size": 14, "lineHeight": 20, "letterSpacing": 0.2, "use": "单位、页脚、操作条按键、副信息" },
    "label":   { "size": 16, "lineHeight": 22, "letterSpacing": 0,   "use": "面板名、页眉、交互提示" },
    "body":    { "size": 18, "lineHeight": 27, "letterSpacing": 0,   "use": "对话台词、信纸正文、菜单项" },
    "h2":      { "size": 22, "lineHeight": 30, "letterSpacing": 0,   "use": "状态行、抽屉标题、暂停标题" },
    "h1":      { "size": 26, "lineHeight": 33, "letterSpacing": 0,   "use": "瞬时大字、结算鱼名" },
    "display": { "size": 34, "lineHeight": 40, "letterSpacing": 0,   "use": "换日 / 章节级大字" }
  },

  "radius": { "key": 3, "panel": 3, "paper": 2, "pill": 999 },

  "border": {
    "hair": 1,
    "hairAccent": 2,
    "color": {
      "panel": "rgba(232,176,75,0.42)",
      "active": "rgba(232,176,75,0.72)",
      "weak": "rgba(232,176,75,0.22)",
      "paper": "#CDBF9F",
      "paperOuter": "#B8A57E"
    },
    "focusRing": { "width": 1, "glow": "0 0 0 2px rgba(232,176,75,0.18)" }
  },

  "shadow": {
    "panel": "0 6px 18px rgba(0,0,0,0.45)",
    "paper": "0 12px 28px rgba(0,0,0,0.45)",
    "creel": "-12px 0 28px rgba(0,0,0,0.35)",
    "text": "0 1px 2px rgba(0,0,0,0.60)",
    "textStrong": "0 1px 3px rgba(0,0,0,0.80)",
    "keyInset": "inset 0 -1px 0 rgba(0,0,0,0.45)"
  },

  "motion": {
    "durFast": 120,
    "durBase": 180,
    "durSlow": 260,
    "holdMsg": 2200,
    "holdCatch": 2600,
    "breath": 1600,
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "panelEnter": { "dy": 8, "duration": 260 },
    "panelExit": { "duration": 180 },
    "maxTravelForText": 12
  },

  "keycap": {
    "height": 22,
    "minWidth": 22,
    "paddingX": 6,
    "radius": 3,
    "bg": "#101A21",
    "border": "1px solid rgba(232,176,75,0.42)",
    "text": { "size": 12, "color": "#E8E5D8", "letterSpacing": 0.5 },
    "pressed": { "offsetY": 1, "bg": "#22323D", "border": "rgba(232,176,75,0.72)" },
    "disabled": { "bg": "#0C1319", "border": "rgba(232,176,75,0.22)", "text": "#6E7A78" },
    "gaps": { "betweenKeys": 4, "betweenGroups": 16, "beforeText": 6 }
  },

  "elements": {
    "keyBar": {
      "x": 24, "y": 24, "height": 36, "paddingX": 12, "radius": 3,
      "bg": "rgba(12,19,25,0.92)",
      "border": { "left": 2, "top": 1, "right": 1, "bottom": 1 },
      "text": { "size": 14, "color": "#E8E5D8" }
    },
    "statLine": {
      "x": 24, "y": 72, "height": 30,
      "text": { "size": 22, "color": "#F5F3EA", "font": "ui", "tabular": true },
      "unit": { "size": 14, "color": "#A9B3AF" },
      "separator": "·", "segmentGap": 12,
      "changeFlash": "#F0C46A"
    },
    "prompt": {
      "x": 24, "y": 110, "height": 24,
      "text": { "size": 16, "color": "#9FD3E6" },
      "keyGap": 8
    },
    "flash": {
      "anchor": "center", "y": 400, "maxWidth": 960,
      "text": { "size": 26, "color": "#F5F3EA", "font": "ui", "align": "center" },
      "dayRule": { "width": 240, "color": "rgba(232,176,75,0.22)", "height": 1 }
    },
    "dialogue": {
      "x": 24, "y": 580, "w": 720, "h": 116, "padding": 16, "radius": 3,
      "bg": "rgba(12,19,25,0.92)",
      "border": { "left": 2, "top": 1, "right": 1, "bottom": 1 },
      "shadow": "panel",
      "name": { "x": 16, "y": 12, "size": 16, "colorNpc": "#E8B04B", "colorPlayer": "#9FD3E6" },
      "line": { "x": 16, "y": 38, "width": 688, "size": 18, "lineHeight": 27, "color": "#F5F3EA", "font": "narrative" },
      "moreIndicator": { "x": 700, "y": 96, "size": 8, "color": "#E8B04B", "breath": true },
      "hold": { "perCharMs": 55, "baseMs": 1800, "minMs": 2600 }
    },
    "letter": {
      "x": 240, "y": 80, "w": 800, "h": 560, "radius": 2,
      "bg": "linear-gradient(145deg,#F7F0E2,#EFE5D2)",
      "border": "1px solid #CDBF9F",
      "outerBorder": "1px solid #B8A57E",
      "topHighlight": "1px rgba(255,255,255,0.55)",
      "header": { "x": 40, "y": 32, "size": 16, "color": "#5E5342" },
      "headerRule": { "y": 64, "x1": 40, "x2": 760, "color": "#CDBF9F", "height": 1 },
      "body": { "x": 40, "y": 88, "width": 720, "size": 18, "lineHeight": 30.6, "color": "#1A2939", "font": "narrative", "maxLines": 12 },
      "footer": { "x2": 760, "y": 520, "size": 14, "color": "#5E5342" },
      "keycapOnPaper": { "bg": "#EFE5D2", "border": "1px solid #B8A57E", "text": "#1A2939" }
    },
    "catchCard": {
      "x": 430, "y": 452, "w": 420, "h": 140, "radius": 3,
      "bg": "rgba(12,19,25,0.94)",
      "border": { "left": 2, "top": 1, "right": 1, "bottom": 1, "leftColor": "#E8B04B" },
      "shadow": "panel",
      "name": { "x": 24, "y": 20, "size": 26, "color": "#F5F3EA", "font": "narrative" },
      "size": { "x": 24, "y": 58, "size": 16, "color": "#A9B3AF" },
      "value": { "x2": 396, "y": 24, "size": 22, "color": "#E8B04B", "align": "right" },
      "creel": { "x2": 396, "y": 54, "size": 14, "color": "#A9B3AF", "align": "right" },
      "rule": { "y": 92, "x1": 24, "x2": 396, "color": "rgba(232,176,75,0.22)" },
      "hint": { "x": 24, "y": 102, "size": 14, "color": "#A9B3AF" },
      "badge": {
        "x": 396, "y": 10, "h": 18, "paddingX": 6, "radius": 3,
        "bg": "rgba(232,176,75,0.94)", "text": { "size": 12, "color": "#070C10" }
      }
    },
    "pause": {
      "mask": "rgba(7,12,16,0.72)",
      "x": 400, "y": 164, "w": 480, "h": 392, "radius": 3,
      "bg": "rgba(12,19,25,0.96)",
      "title": { "x": 24, "y": 18, "size": 22, "color": "#F5F3EA" },
      "titleKey": { "x2": 456, "y": 18 },
      "titleRule": { "y": 52, "x1": 24, "x2": 456, "color": "rgba(232,176,75,0.22)" },
      "rows": { "count": 5, "height": 48, "x1": 8, "x2": 472, "startY": 60, "paddingLeft": 16, "paddingRight": 16 },
      "rowText": { "size": 18, "color": "#E8E5D8" },
      "rowFocus": {
        "bg": "rgba(232,176,75,0.10)",
        "bar": { "width": 3, "insetY": 8, "height": 32, "color": "#E8B04B" },
        "text": "#F0C46A",
        "arrow": { "size": 8, "color": "#E8B04B" }
      },
      "rowDisabled": { "text": "#6E7A78" },
      "slider": {
        "track": { "x1": 240, "x2": 420, "height": 4, "radius": 2, "bg": "#22323D", "fill": "#E8B04B" },
        "knob": { "size": 12, "radius": 999, "bg": "#F0C46A", "ring": "2px #0C1319" },
        "value": { "x2": 456, "size": 14, "color": "#A9B3AF" }
      },
      "footer": { "x": 24, "y": 348, "size": 14, "color": "#A9B3AF" }
    },
    "creel": {
      "x": 920, "y": 0, "w": 360, "h": 720,
      "bg": "rgba(12,19,25,0.96)",
      "border": { "left": 1, "innerLeft": 2 },
      "shadow": "creel",
      "title": { "x": 24, "y": 24, "size": 22, "color": "#F5F3EA" },
      "total": { "x2": 336, "y": 28, "size": 14, "color": "#E8B04B", "align": "right" },
      "titleRule": { "y": 64, "x1": 24, "x2": 336, "color": "rgba(232,176,75,0.22)" },
      "listStartY": 76,
      "rowHeight": 56,
      "rowRule": { "color": "rgba(232,176,75,0.10)", "x1": 24, "x2": 336 },
      "name": { "x": 24, "dy": 10, "size": 18, "color": "#F5F3EA" },
      "size": { "x": 24, "dy": 30, "size": 14, "color": "#A9B3AF" },
      "value": { "x2": 336, "dy": 12, "size": 16, "color": "#E8B04B", "align": "right" },
      "mark": { "x2": 336, "dy": 32, "size": 12, "color": "#9FD3E6", "align": "right" },
      "empty": { "y": 320, "size": 16, "color": "#A9B3AF", "align": "center" },
      "scroll": { "barWidth": 4, "thumb": "rgba(232,176,75,0.42)", "track": "#22323D" },
      "enter": { "dx": 24, "duration": 260 }
    }
  },

  "layers": {
    "world": 0, "hud": 10, "flash": 20, "catch": 20,
    "dialogue": 30, "creel": 40, "mask": 44, "letter": 45, "pause": 50
  },

  "weather": {
    "dawn":       { "panelAlpha": 0.92, "textShadow": "text" },
    "noon":       { "panelAlpha": 0.92, "textShadow": "text" },
    "dusk":       { "panelAlpha": 0.92, "borderBoost": "a72", "textShadow": "text" },
    "night":      { "panelAlpha": 0.96, "textShadow": "textStrong", "minReadableSize": 14, "muteBecomes": "#E8E5D8" },
    "fog":        { "panelAlpha": 0.92, "textShadow": "textStrong" }
  },

  "copy": {
    "keybar.shore": [["W A S D", "走"], ["F", "送鱼"], ["E", "卖鱼/上船"], ["R", "买饵"]],
    "keybar.sea": [["W", "前进"], ["S", "后退"], ["A/D", "转向"], ["Space", "抛竿"], ["E", "上岸"], ["T", "读信"], ["Esc", "退出"]],
    "stat.shore": ["第 1 天", "钱 0 文", "饵 6 个", "鱼篓 0 条"],
    "stat.sea": ["第 1 天", "钱 0 文", "饵 6 个", "鱼篓 0 条", "浅滩湾"],
    "prompt.give": "[F] 把鱼送给 灯婆",
    "prompt.given": "灯婆 收过你的鲈鱼了　[F] 再送一条",
    "prompt.board": "[E] 上船　鱼篓 2 条　钱 240 文",
    "msg.sell": "卖了 3 条，得 96 文",
    "msg.sellSub": "共 240 文",
    "msg.day": "第 4 天",
    "msg.daySub": "有人把昨天的鱼用起来了",
    "msg.cast": "抛竿……",
    "msg.bite": "咬钩了！[Space]",
    "msg.escape": "跑了……[Space] 再抛一竿",
    "msg.nobait": "饵用完了，靠码头按 [R] 买（8 文 5 个）",
    "msg.fog": "今天海上有雾，远处看不清",
    "msg.edge": "再往外就只有雾了",
    "msg.dolphin": "一群海豚贴着船边过去了",
    "msg.gull": "海鸟 叼走了你的鲈鱼，留下一样东西：船舱里多了一封信（[T] 读）",
    "dialogue.npc": ["灯婆", "「这么肥，得配点姜。」"],
