    "catch.name": "鲈鱼",
    "catch.size": "42 cm",
    "catch.value": "38 文",
    "catch.creel": "鱼篓 3 条",
    "catch.hint": "按 空格 再抛一竿",
    "catch.badge": "新记录",
    "pause.title": "暂停",
    "pause.rows": ["继续", "音量", "操作说明", "回到标题", "退出游戏"],
    "pause.footer": "方向键选择　Enter 确认",
    "creel.title": "鱼篓",
    "creel.total": "共 7 条",
    "creel.empty": ["鱼篓是空的", "按 [E] 上岸卖鱼"],
    "letter.header": "第 3 封　·　第 1 页",
    "letter.footer": "[T] 下一页"
  },

  "doNot": [
    "圆形头像 / 玻璃拟态 / 霓虹描边",
    "顶部满宽状态栏",
    "第四种强调色",
    "UI 上叠纸纹 / 胶片颗粒 / 噪点",
    "右键菜单 / 拖拽排序",
    "六点省略号以外的写法",
    "逐字打字机动画"
  ]
}
